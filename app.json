{
  "expo": {
    "name": "Traken Mobile",
    "slug": "traken-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#16214d",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "mx.apsholding.traken"
    },
    "android": {
      "package": "mx.apsholding.traken",
      "adaptiveIcon": {
        "backgroundColor": "#16214d",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Traken Operaciones",
      "shortName": "Traken",
      "themeColor": "#16214d",
      "backgroundColor": "#16214d",
      "display": "standalone",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-foreground.png",
          "color": "#16214d"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "cdb40c0b-1a6a-4a9f-a7b4-5797009678bf"
      }
    },
    "owner": "aps-holding-1a",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/cdb40c0b-1a6a-4a9f-a7b4-5797009678bf"
    }
  }
}
